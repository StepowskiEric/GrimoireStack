{
  "name": "grimoirestack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/sync-all.mjs && node scripts/registry/index.mjs && node scripts/build-skill-map.mjs && node scripts/build-ai-catalog.mjs && npm run typecheck && vite build && node scripts/prerender.mjs && node scripts/build-sitemap.mjs && node scripts/build-rss.mjs",
    "build:sync": "node ../scripts/sync-all.mjs",
    "build:registry": "node scripts/registry/index.mjs",
    "build:vite": "vite build",
    "build:catalog": "node scripts/build-ai-catalog.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "SKIP_WEB_SERVER=1 playwright test",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src scripts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "biome:check": "biome check .",
    "biome:lint": "biome lint .",
    "biome:format": "biome format .",
    "biome:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "sync": "node ../scripts/sync-all.mjs",
    "sync:dry": "node ../scripts/sync-all.mjs --dry",
    "skill": "node ../scripts/skill.mjs",
    "add-skill": "node ../scripts/skill.mjs add",
    "remove-skill": "node ../scripts/skill.mjs remove",
    "fallow": "npx fallow",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "fallow:fix-dry": "npx fallow fix --dry-run",
    "fallow:fix": "npx fallow fix --yes",
    "fallow:full": "npx fallow"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "page-agent": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  },
  "nx": {}
}
