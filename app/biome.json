{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!node_modules",
      "!!coverage",
      "!!playwright-report",
      "!!test-results",
      "!!.nx",
      "!!app-dist",
      "!!site",
      "!!scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off",
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "useImportType": "warn",
        "useNamingConvention": "off",
        "noNonNullAssertion": "off",
        "useConsistentArrayType": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off",
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true,
            "skipIifes": false
          }
        }
      },
      "a11y": {
        "recommended": false,
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off",
        "useTopLevelRegex": "off"
      }
    },
    "domains": {
      "react": "recommended",
      "next": "none",
      "test": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}